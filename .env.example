# Entrada da aplicacao: run.py em desenvolvimento, wsgi.py em producao.
FLASK_APP=wsgi:app

# development | production. Em "production" os cookies de sessao saem com
# Secure (exigem HTTPS) e a aplicacao recusa subir sem SECRET_KEY real.
FLASK_ENV=development

# Apenas em desenvolvimento. Nunca habilite em producao.
FLASK_DEBUG=0

# Obrigatoria em producao. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=altere-esta-chave-para-um-valor-seguro

# Padrao: sqlite:///instance/app.db
# PrefixosAntigos (postgresql://, postgres://, mysql://) sao normalizados.
# Para PostgreSQL: pip install psycopg2-binary
# DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/softclinica